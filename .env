# Application
APP_NAME=my_app
APP_ENV=local
APP_URL=https://app.test
APP_VERSION=0.0.1

# SwooleServer
AUTORELOAD_PROGRAMS=""
AUTORELAD_ANY_FILES=0

# JWT
JWT_SECRET_KEY=/secrets/private.pem
JWT_PUBLIC_KEY=/secrets/public.pem
JWT_PASS_PHRASE=phrase
JWT_TOKEN_TTL=3600
JWT_ISSUER=https://issuer.com
JWT_AUDIENCE=https://audience.com

# Database
DB_CONNECTION=pdo_pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=spatialDB
DB_USERNAME=postgres
DB_PASSWORD=admin123

DB_NAME_IDENTITY=identityDB


# Redis
REDIS_HOST=redis_host
REDIS_PORT=6379
REDIS_PASSWORD=password


# Mail SMTP
MAIL_HOST=smtp.mail.com
MAIL_USER=usermail
MAIL_PASS=pass


#OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=host.docker.internal:4318